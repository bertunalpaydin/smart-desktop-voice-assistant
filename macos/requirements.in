# What Jarvis needs on a Mac. install.sh installs the exact versions in
# requirements-py3XX.txt, which are made from this file with:
#   uv pip compile requirements.in --python-version 3.13 --python-platform aarch64-apple-darwin \
#       --only-binary :all: --generate-hashes -o requirements-py313.txt
